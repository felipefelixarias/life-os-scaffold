{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-os.schema/profile.json",
  "title": "Life OS Profile Configuration",
  "description": "Configuration schema for life-os user profile settings",
  "type": "object",
  "required": ["owner", "timezone", "planning", "domains", "energy_curve", "priority_tiers"],
  "properties": {
    "owner": {
      "type": "string",
      "description": "The name of the profile owner",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone identifier",
      "pattern": "^[A-Za-z]+/[A-Za-z_]+$",
      "examples": ["America/New_York", "Europe/London", "Asia/Tokyo"]
    },
    "planning": {
      "type": "object",
      "description": "Daily planning configuration",
      "required": ["weekday_wake", "weekend_earliest", "day_end", "bedtime", "workday_start", "workday_end"],
      "properties": {
        "weekday_wake": {
          "type": "string",
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Weekday wake time in HH:MM format"
        },
        "weekend_earliest": {
          "type": "string",
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Earliest acceptable weekend wake time"
        },
        "day_end": {
          "type": "string",
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
          "description": "End of productive day"
        },
        "bedtime": {
          "type": "string",
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Target bedtime"
        },
        "workday_commute_start": {
          "type": "string",
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
          "description": "When to start commute to work"
        },
        "workday_start": {
          "type": "string",
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
          "description": "When work starts"
        },
        "workday_end": {
          "type": "string",
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
          "description": "When work ends"
        },
        "workday_commute_home_end": {
          "type": "string",
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
          "description": "When commute home ends"
        },
        "default_task_block_mins": {
          "type": "integer",
          "minimum": 15,
          "maximum": 480,
          "description": "Default task block duration in minutes"
        },
        "deep_work_block_mins": {
          "type": "integer",
          "minimum": 30,
          "maximum": 240,
          "description": "Deep work block duration in minutes"
        },
        "max_screen_block_mins": {
          "type": "integer",
          "minimum": 30,
          "maximum": 240,
          "description": "Maximum continuous screen time in minutes"
        },
        "break_mins": {
          "type": "integer",
          "minimum": 5,
          "maximum": 60,
          "description": "Break duration in minutes"
        },
        "max_major_tasks_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Maximum number of major tasks per day"
        },
        "weekly_review_day": {
          "type": "string",
          "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "description": "Day of the week for weekly reviews"
        }
      },
      "additionalProperties": false
    },
    "domains": {
      "type": "array",
      "description": "Life domains with weights",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "weight"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$",
            "description": "Domain identifier (lowercase letters and underscores only)"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable domain name"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Domain priority weight (1-10)"
          }
        },
        "additionalProperties": false
      }
    },
    "energy_curve": {
      "type": "array",
      "description": "Energy levels throughout the day",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["time", "energy"],
        "properties": {
          "time": {
            "type": "string",
            "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
            "description": "Time in HH:MM format"
          },
          "energy": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "description": "Energy level at this time"
          }
        },
        "additionalProperties": false
      }
    },
    "priority_tiers": {
      "type": "array",
      "description": "Priority tier definitions",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["tier", "label", "examples"],
        "properties": {
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "description": "Tier number (1 = highest priority)"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable tier name"
          },
          "examples": {
            "type": "string",
            "minLength": 1,
            "description": "Examples of tasks in this tier"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}