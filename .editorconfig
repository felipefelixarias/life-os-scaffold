# EditorConfig: https://editorconfig.org
#
# Consistent coding style across editors and IDEs for contributors.
# Pairs with the black/ruff/mypy configuration in pyproject.toml.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Python — matches [tool.black] line-length = 88 in pyproject.toml.
[*.py]
indent_size = 4
max_line_length = 88

# Shell scripts
[*.sh]
indent_size = 2

# YAML, TOML, JSON: 2-space convention.
[*.{yml,yaml,toml,json}]
indent_size = 2

# Markdown: keep trailing whitespace — two trailing spaces mean hard line break.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Makefiles require literal tabs for recipe lines.
[{Makefile,*.mk}]
indent_style = tab

# CSVs are data, often generated by Python's csv module (CRLF per RFC 4180).
# Don't let editors silently rewrite line endings.
[*.csv]
end_of_line = unset
trim_trailing_whitespace = false
insert_final_newline = unset
